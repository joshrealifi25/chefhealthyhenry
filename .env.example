# Environment variables for chefhealthyhenry.com
#
# Copy to .env.local for local development and fill in real values. Never commit
# .env.local: it is gitignored, and these are live credentials.
#
# Every variable below is read somewhere in src/. `npm run check:content` fails
# if the code reads one that is not listed here, so this file stays honest.
#
# IMPORTANT: adding a variable here does not set it in production. Add it in the
# Vercel dashboard under Settings > Environment Variables, for the Production
# environment as well as Preview. These are read at request time, not build
# time, so a missing one deploys green and then errors on the live site.

# --- Site ---------------------------------------------------------------
# Canonical public URL, used for absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=https://chefhealthyhenry.com

# --- Email (Resend) -----------------------------------------------------
# Transactional email plus the welcome sequence broadcasts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Audience that new newsletter subscribers are added to.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
# From address on every outbound email. Must be a verified Resend sender.
EMAIL_FROM="Chef Healthy Henry <hello@chefhealthyhenry.com>"

# --- Commerce (Stripe) --------------------------------------------------
# Secret key for the cookbook checkout.
STRIPE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Signing secret for the /api/stripe/webhook endpoint. Distinct per environment:
# the test-mode webhook and live-mode webhook have different secrets.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Cookbook delivery --------------------------------------------------
# Signs the time-limited download links emailed after purchase. Rotating this
# invalidates every outstanding download link, so treat it as long-lived.
DOWNLOAD_SIGNING_SECRET=generate-a-long-random-string
# Vercel Blob token for the stored cookbook PDFs.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
